# Set values on the server, not in client JavaScript.
ONESHOT_API_TOKEN=replace-with-random-token-at-least-24-characters
ONESHOT_BROWSER_PASSWORD=replace-with-distinct-password-at-least-16-characters
ONESHOT_DATA_DIR=./data
ONESHOT_PROVIDER=evidence
# Optional, not a prerequisite for System evidence processing:
# System's single explicitly configured generation provider:
# ONESHOT_PROVIDER=openai  # model is a legacy OpenAI-compatible option
# ONESHOT_MODEL_NAME=your-supported-model
# ONESHOT_MODEL_TOKEN=server-side-secret
# ONESHOT_MODEL_ENDPOINT=https://api.openai.com/v1/chat/completions
# OR (native Gemini):
# ONESHOT_PROVIDER=gemini
# ONESHOT_MODEL_NAME=your-gemini-model
# ONESHOT_MODEL_TOKEN=server-side-gemini-key
# OR (local Ollama, not automatically accessible inside Docker):
# ONESHOT_PROVIDER=ollama
# ONESHOT_MODEL_NAME=your-installed-local-model
# ONESHOT_MODEL_ENDPOINT=http://127.0.0.1:11434/api/chat

# Optional Agent Chat integrations are INDEPENDENT from System provider.
# Only configured entries appear in the Agent selector; secrets stay server-side.
# ONESHOT_AGENT_OPENAI_TOKEN=agent-only-secret
# ONESHOT_AGENT_OPENAI_MODEL=agent-model-name
# ONESHOT_AGENT_GEMINI_TOKEN=agent-only-secret
# ONESHOT_AGENT_GEMINI_MODEL=gemini-model-name
# ONESHOT_AGENT_OLLAMA_MODEL=installed-local-model
# ONESHOT_AGENT_OLLAMA_ENDPOINT=http://127.0.0.1:11434/api/chat

# Independent, non-Agent deterministic evaluation; yield to foreground jobs.
ONESHOT_SYSTEM_BACKGROUND=true
